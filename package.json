    "ccusage:bump": "bun ./scripts/bump-ccusage-version.mjs",
    "bundle:plugins": "bun copy-bundled.cjs",
    "preview": "vite preview",
    "test": "vitest",
    "test:web": "vitest run --config web/vitest.config.ts",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage.enabled",
    "collector:dev": "node collector/server.mjs",
    "collector:test": "node collector/server.test.mjs",
    "tauri": "tauri"
  },
  "dependencies": {
