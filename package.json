{
  "name": "eusage",
  "private": true,
  "version": "0.6.27",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:web": "convex dev --start \"vite --config web/vite.config.ts\"",
    "dev:desktop": "bun tauri dev",
    "build": "tsc && vite build",
    "build:web": "vite build --config web/vite.config.ts",
    "build:vercel": "node scripts/build-vercel-web.mjs",
