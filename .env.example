# Tauri updater signing
TAURI_SIGNING_PRIVATE_KEY=/path/to/your.key
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# macOS code signing
APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Notarization
APPLE_ID=
APPLE_PASSWORD=
APPLE_TEAM_ID=

# Collector
EUSAGE_ADMIN_TOKEN=
EUSAGE_DATA_FILE=collector/data/eusage.json
PORT=8787

# Web/Convex
CONVEX_DEPLOYMENT=
VITE_CONVEX_URL=

# Optional Antigravity refresh support
ANTIGRAVITY_GOOGLE_CLIENT_ID=
ANTIGRAVITY_GOOGLE_CLIENT_SECRET=
